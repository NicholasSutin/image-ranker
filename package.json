{
  "name": "image-ranker",
  "private": true,
  "type": "module",
  "scripts": {
    "manifest": "node scripts/build-manifest.mjs",
    "dev": "npm run manifest && wrangler dev",
    "deploy": "npm run manifest && wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply image-ranker --local",
    "db:init": "wrangler d1 migrations apply image-ranker --remote"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.141.0"
  }
}
